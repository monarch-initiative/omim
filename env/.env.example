# Parallel LinkML path — optional. Prefer reusing legacy root .env (API_KEY).
# Same GitHub secret as legacy CI: MONARCH_OMIM_API_KEY (written as API_KEY).
#
# If acquire returns 401: confirm the key is valid (not expired). If the key is correct in
# this file but still 401, run `unset OMIM_API_KEY` / `unset API_KEY` — an empty export
# in the shell can mask this file.
# Save with Unix line endings (LF). CRLF adds a stray \r to the key and breaks ApiKey.

# Optional alias; if unset, acquire falls back to API_KEY from repo-root .env
# OMIM_API_KEY=

# Optional; defaults to https://api.omim.org/api if unset
# OMIM_API_BASE_URL=https://api.omim.org/api
# OMIM_API_DOCS_URL=https://omim.org/help/api
# OMIM_API_HTML_URL=https://api.omim.org/api/html/index.html

# Optional: override SOLR search used to list entries
# OMIM_SEARCH_QUERY=*

# Optional: SOLR filter, e.g. phenotype-only prefix (URL-encoded # = %23): prefix:%23
# OMIM_SEARCH_FILTER=

# Optional: stop after N distinct MIM numbers during search (local testing)
# OMIM_MAX_MIMS=

# Optional: seconds to sleep after each successful HTTP response
# OMIM_SLEEP_SECONDS=

# Optional: per-request retries after HTTP 429 (default 24 if unset)
# OMIM_429_MAX_RETRIES=
